FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/emailer ./cmd/emailer
COPY internal/email ./internal/email

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o emailer ./cmd/emailer

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/emailer .

EXPOSE 8085

CMD ["./emailer"]
